# Base URL of the Fieldscope serving API, with no trailing slash.
#
# An environment variable rather than a constant because the deployed API sits
# behind a Cloudflare quick tunnel, whose hostname changes every time the
# tunnel restarts (docs/DESIGN.md §13). Point it at the local stack for
# development, and at the current tunnel hostname for a deployed build.
VITE_API_BASE_URL=http://localhost:8000
